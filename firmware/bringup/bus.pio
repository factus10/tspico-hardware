; TS-Pico v3 bus programs, shadow mode: everything a served memory read does
; except driving the 2068. U3 (nDATA_OE) and /BE (BE_REQ) are never enabled, so
; the 2068 runs on its own ROM while these programs follow every read.
;
; Pin numbers are absolute GPIOs. bus_fetch and bus_decide run in PIO blocks
; with GPIO base 0; the markers run in PIO2 with GPIO base 16 so they can reach
; the J3 header (GP34, GP41-43). Fetch and decide signal the markers through
; PIO2's IRQ flags (irq next / irq prev).
;
;   flag 0/1  fetch: strobe seen / address captured     -> FRONT marker (GP43, J3.3)
;   flag 2/3  fetch: strobe seen / byte on MD           -> READY marker (GP42, J3.4)
;   flag 4/5  decide: cycle served / cycle over         -> SERVE marker (GP41, J3.5)
;   flag 6    decide: /BE would be asserted             -> BE marker    (GP34, J3.6)
;   flag 7    SERVE marker to BE marker: cycle over

.pio_version 1

; -----------------------------------------------------------------------------
; bus_fetch (PIO1): on every memory read, read the Z80 address through the byte
; mux, append the cycle class, push a pointer into the byte images for the DMA
; chain, and put the byte it returns on MD.
;
; Pointer = X (14 bits) << 18 | A15..A0 << 2 | nEXROM:nROSCS, so the images are
; interleaved with a stride of four: the byte for (address, class) is at
; region + 4 * address + class.
;
; in/out base GP0 (MD0-MD7, 8 out pins); side-set GP8 nAEN_LO (bit 0) and GP9
; nAEN_HI (bit 1); ISR shifts left with autopush at 32; OSR shifts right.
; -----------------------------------------------------------------------------
.program bus_fetch
.side_set 2 opt
.wrap_target
    wait 0 gpio 15          side 0b11       ; nMEMRD: /MREQ and /RD both low
    in x, 14                side 0b01       ; image region; U2 puts A15..A8 on MD
    irq next set 0
    irq next set 2
public hi_delay:
    set y, 5                                ; patched from C: U2 enable to sample
hi_wait:
    jmp y-- hi_wait
    in pins, 8              side 0b11 [1]   ; A15..A8 (pins as of two cycles ago); U2 off
    nop                     side 0b10       ; U1 puts A7..A0 on MD
public lo_delay:
    set y, 5                                ; patched from C: U1 enable to sample
lo_wait:
    jmp y-- lo_wait
    in pins, 8              side 0b11       ; A7..A0; U1 off
public class_settle:
    set y, 0                                ; patched from C: wait for /ROSCS, /EXROM
class_wait:
    jmp y-- class_wait
    mov osr, pins
    out null, 19
    in osr, 2                               ; nEXROM:nROSCS; autopush the pointer
    irq next set 1
    pull block                              ; the byte, from the DMA chain
    mov pindirs, ~null
    out pins, 8                             ; onto MD; U3 is off unless bus_serve enables it
    irq prev set 0                          ; tell bus_serve (PIO0) the byte is ready
    irq next set 3
    wait 1 gpio 15
    mov pindirs, null
.wrap

; -----------------------------------------------------------------------------
; stopwatch_strobe (PIO1): pushes how long each read strobe stays low, in
; 2-cycle loops. jmp pin = GP15 (nMEMRD).
; -----------------------------------------------------------------------------
.program stopwatch_strobe
.wrap_target
    wait 0 gpio 15
    mov x, ~null
low:
    jmp pin done
    jmp x-- low
done:
    mov isr, ~x
    push noblock
.wrap

; -----------------------------------------------------------------------------
; bus_decide (PIO0, shadow mode): classify every memory read the way the v2.1
; set_ctrl rule does. For the CPU's statistics it pushes GP13-GP20 as sampled:
; bit 0 A14, bit 1 A15, bit 6 nROSCS, bit 7 nEXROM; core 1 works out the class.
;   EXROM (/EXROM low) and HOME (neither select, A15:A14 = 0) would assert /BE;
;   DOCK (/ROSCS low) would be served without it.
; -----------------------------------------------------------------------------
.program bus_decide
.wrap_target
top:
    wait 0 gpio 15
public decide_settle:
    set y, 0                                ; patched from C
settle:
    jmp y-- settle
    mov osr, pins
    out null, 13
    in osr, 8                               ; GP13-GP20 for the statistics
    push noblock
    out x, 2                                ; A15:A14
    out null, 4
    out y, 2                                ; nEXROM:nROSCS
    jmp y-- class_ge1
not_ours:                                   ; also class 0, both selects low
    wait 1 gpio 15
    jmp top
class_ge1:
    jmp !y be                               ; EXROM
    jmp y-- class_ge2
class_ge2:
    jmp !y serve                            ; DOCK
    jmp !x be                               ; HOME: neither select, low 16K
    jmp not_ours
public be:
    irq prev set 6
serve:
    irq prev set 4
    wait 1 gpio 15
    irq prev set 5
.wrap

; -----------------------------------------------------------------------------
; bus_serve (PIO0, instead of bus_decide): serves reads for real, with the same
; classification and statistics. HOME and EXROM: assert /BE as soon as the class
; is known, enable U3 once bus_fetch has the byte on MD (PIO0 flag 0, raised by
; bus_fetch), release both when the strobe ends. DOCK: the same without /BE
; (nothing in the 2068 drives the dock bank), and only while DOCK serving is on:
; dock_op is patched from C. Every path consumes bus_fetch's flag.
;
; set pin GP11 BE_REQ; side-set GP10 nDATA_OE. Idle: /BE off, U3 off.
; -----------------------------------------------------------------------------
.program bus_serve
.side_set 1 opt
.wrap_target
top:
    wait 0 gpio 15
public serve_settle:
    set y, 0                                ; patched from C
settle:
    jmp y-- settle
    mov osr, pins
    out null, 13
    in osr, 8                               ; GP13-GP20 for the statistics
    push noblock
    out x, 2                                ; A15:A14
    out null, 4
    out y, 2                                ; nEXROM:nROSCS
    jmp y-- class_ge1
public not_ours:                            ; also class 0
    wait 1 irq 0
    wait 1 gpio 15
    jmp top
class_ge1:
public exrom_op:
    jmp !y be                               ; EXROM; `jmp !y not_ours` while EXROM serving is off
    jmp y-- class_ge2
class_ge2:
public dock_op:
    jmp !y serve                            ; DOCK; `jmp !y not_ours` while DOCK serving is off
    jmp !x be                               ; HOME
    jmp not_ours
public be:
    set pins, 1                             ; /BE on, U3 still off
public serve:
    wait 1 irq 0                            ; byte on MD
    nop                     side 0          ; U3 on: the byte goes to the Z80
    wait 1 gpio 15
    set pins, 0             side 1          ; U3 off, /BE off
.wrap

; -----------------------------------------------------------------------------
; Markers (PIO2, GPIO base 16): one pin each, set by the flags above.
; -----------------------------------------------------------------------------
.program marker_front
.wrap_target
    wait 1 irq 0
    set pins, 1
    wait 1 irq 1
    set pins, 0
.wrap

.program marker_ready
; Also times the interval: pushes the number of 3-cycle loops between flag 2
; (strobe seen) and flag 3 (byte on MD). `mov y, status` reads flag 3: bus_shadow.c
; sets that up, because SDK 2.1.1's pioasm emits an undefined name for .mov_status irq.
.wrap_target
    wait 1 irq 2
    set pins, 1
    mov x, ~null
count:
    mov y, status                           ; all ones once flag 3 is set
    jmp !y more
    jmp done
more:
    jmp x-- count
done:
    irq clear 3
    set pins, 0
    mov isr, ~x
    push noblock
.wrap

.program marker_serve
.wrap_target
    wait 1 irq 4
    set pins, 1
    wait 1 irq 5
    set pins, 0
    irq set 7
.wrap

.program marker_be
.wrap_target
    wait 1 irq 6
    irq clear 7                             ; left over from a DOCK cycle
    set pins, 1
    wait 1 irq 7
    set pins, 0
.wrap
