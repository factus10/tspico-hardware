  (text "RP2040 after the minimal design in 'Hardware design with RP2040'. GPIO map identical to the v2.2 Pico (Pico.SchDoc): GP0-GP22, GP26-GP28 carry the same signals." (exclude_from_sim no) (at 20 278 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "81c14df0-10e3-4104-bbf3-ccbf65927a26"))
  (text "GP23 test pad, GP24 VBUS sense, GP25 LED, GP29 VSYS/3: as on the Pico, so the Pico MicroPython build sees the same board." (exclude_from_sim no) (at 20 282 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "3d063dfe-0dbb-420d-8a55-523aa784a04f"))
  (text "VSYS = edge +5V through D2 (as v2.2) or USB VBUS through D4; U22 AMS1117-3.3. The card's 5 V logic and memories run from the edge only." (exclude_from_sim no) (at 20 286 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "bd3e4ddf-03c3-438c-ba6c-a5d8a134c2d1"))
  (text "SW4 BOOTSEL, SW3 RUN (Pico reset). R15/R16 hold the memories deselected until the firmware drives GP19/GP20." (exclude_from_sim no) (at 20 290 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "7457fe3d-475e-4b3e-8b31-d4570cd1a75e"))
  (embedded_fonts no)
)
