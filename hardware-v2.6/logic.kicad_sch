  (label "GND" (at 318.77 151.13 270) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "3303f6af-1bd4-4a6e-b03a-0b3f51cf1efd"))
  (text "The v2.2 bus logic (Logic.schdoc) rebuilt in 74LVC at 3.3 V: same logic at every Pico pin. /+W = I/O read of the card's port; /+RW = any I/O to it (not INTA)." (exclude_from_sim no) (at 20 278 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "5ebecb2b-259f-41fa-b240-39749c5dd750"))
  (text "U5 decodes the port (A7-A4, /IORQ, /M1); U4 makes /+RW, /+W, /RDROM; U1 /MREQ_G; U9 the open-drain /BE. U7 channel 5 = /BE_IN -> /BE_STAT." (exclude_from_sim no) (at 20 282 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "23b957ed-3b5d-4cc5-91ba-5248b874b645"))
  (text "R12: 4.7k pull-down on D6 at U6 (pins 8 to 10), a post-2023 rework on v2.2 boards, now a fitted part." (exclude_from_sim no) (at 20 286 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "9731ffd5-d2c8-4e63-9ee1-f12d85c86a1e"))
  (text "JP4: 1-2 (as shipped) answers $00-$0F, 2-3 answers $10-$1F. U8 C/D sections unused (inputs grounded)." (exclude_from_sim no) (at 20 290 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "ac520bfb-d44f-4261-99d5-f236a2cafa32"))
  (embedded_fonts no)
)
